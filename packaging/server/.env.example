# Exemple d'environnement pour docker-compose (copier en « .env », NE PAS committer).
# Toutes les variables sont optionnelles : vides, la pile démarre en mode fermé
# (administration verrouillée, OIDC désactivé, secret comptes auto-généré).

# Compte opérateur qui amorce le RBAC de nd-api (sinon administration verrouillée).
ND_COMPTE_RACINE=

# Secret serveur de nd-accounts (hex). Vide = fichier <base>.cle auto-généré.
ND_ACCOUNTS_SECRET=

# Fédération OIDC de nd-accounts (renseigner les 6 pour l'activer).
ND_OIDC_ISSUER=
ND_OIDC_AUTH_ENDPOINT=
ND_OIDC_TOKEN_ENDPOINT=
ND_OIDC_JWKS_URI=
ND_OIDC_CLIENT_ID=
ND_OIDC_REDIRECT_URI=
ND_OIDC_LIER_PAR_EMAIL=
