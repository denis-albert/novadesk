# Source unique de vérité pour le packaging NovaDesk.
# Fichier « clé=valeur » : sourçable en shell (`. version.env`), lisible par
# Python/PowerShell. Les workflows CI et les scripts de build le lisent au lieu
# de coder la version en dur. Garder ALIGNÉ avec :
#   - Cargo.toml           ([workspace.package] version)
#   - ui/pubspec.yaml      (version)
#
# NB : aucune valeur secrète ici. Les certificats/clés passent par des secrets CI.

# Identité produit (identique sur toutes les plateformes).
# Les valeurs contenant des espaces sont entre guillemets (fichier sourçable en shell).
NOVADESK_VERSION=0.1.0
NOVADESK_APP_NAME=NovaDesk
NOVADESK_BINARY=novadesk
NOVADESK_VENDOR="Équipe NovaDesk"
NOVADESK_APP_ID=com.novadesk.NovaDesk
NOVADESK_HOMEPAGE=https://novadesk.example
NOVADESK_DESCRIPTION="Bureau à distance NovaDesk (cœur Rust, UI Flutter)"

# Windows (installeur MSI / WiX). L'UpgradeCode DOIT rester stable entre versions
# (sinon les mises à jour majeures MSI ne se remplacent plus).
NOVADESK_WIN_UPGRADE_CODE=9820A326-4BE2-40EC-9BE4-882D9AAA3E65
NOVADESK_WIN_SERVICE=novadesk-svc

# Linux (systemd, service d'accès non surveillé côté client).
NOVADESK_LINUX_SERVICE=novadesk

# Canal de mise à jour par défaut d'un build (stable|beta|canary|lts).
NOVADESK_CHANNEL=stable
